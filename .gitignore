# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.worktrees/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# IR deck visual QA output (regenerated by scripts/verify-ir-deck.mjs)
/artifacts/

# next.js
/.next/
/out/

# runtime-generated shortform clips (content automation pipeline output)
/public/generated/

# scoped python venv for the CapCut draft export script
/.venv-capcut/

# scoped python venv for MediaPipe pose/beat analysis
/.venv-vision/

# generic python venvs (no scoped script currently needs these)
/.venv/
/venv/

# local OAuth token storage (single-user local demo, never commit)
/.youtube-tokens.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# third-party agent skills (reinstall from skills-lock.json); keep the project's own enter-ax-ui
/.agents/skills/*
!/.agents/skills/enter-ax-ui/
