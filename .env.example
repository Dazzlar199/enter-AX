NEXT_PUBLIC_BACKEND_MODE=demo
DATABASE_URL=postgres://enter_ax_app:enter_ax_app@localhost:54329/enter_ax_test
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
CAPCUT_PYTHON_BIN=.venv-capcut/bin/python

# Existing content automation integrations
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# LLM provider: Gemini when GEMINI_API_KEY is set (or LLM_PROVIDER=gemini), otherwise local Ollama.
# Get a key at https://aistudio.google.com/apikey and put it in .env.local (never commit it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=
# Content/talent/AX automation routes are refused in production unless this is "true".
ENABLE_CONTENT_AUTOMATION=
OLLAMA_HOST=http://localhost:11434
SHORTFORM_PLAN_MODEL=qwen2.5:7b-instruct
WHISPER_MODEL=Xenova/whisper-base

# YouTube OAuth (src/lib/auth/youtube.ts)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
